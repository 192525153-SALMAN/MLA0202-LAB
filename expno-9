#Compare Linear and Polynomial Regression
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures

# Sample Dataset
X = np.array([[1], [2], [3], [4], [5]])
y = np.array([2, 5, 10, 17, 26])

# Linear Regression
linear = LinearRegression()
linear.fit(X, y)

# Polynomial Regression (Degree = 2)
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

poly_model = LinearRegression()
poly_model.fit(X_poly, y)

# Prediction for X = 6
linear_pred = linear.predict([[6]])
poly_pred = poly_model.predict(poly.transform([[6]]))

print("Linear Regression Prediction:", linear_pred[0])
print("Polynomial Regression Prediction:", poly_pred[0])

print("\nLinear Regression Score:", linear.score(X, y))
print("Polynomial Regression Score:", poly_model.score(X_poly, y))
